{
  "$defs": {
    "Hit": {
      "additionalProperties": false,
      "description": "One note a search found.",
      "properties": {
        "id": {
          "description": "The note.",
          "format": "uuid",
          "type": "string"
        },
        "score": {
          "description": "Its score, comparable only within this search.",
          "format": "float",
          "type": "number"
        },
        "similarity": {
          "description": "How close it is in meaning to the query, if vector search found it.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "source_url": {
          "description": "The URL it came from.",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Its tags.",
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "text": {
          "description": "The part of it that matched best.",
          "maxLength": 100000,
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "maxLength": 256,
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/TrustLabel",
          "description": "Whether it may be treated as instructions."
        }
      },
      "required": [
        "id",
        "title",
        "text",
        "tags",
        "trust",
        "score"
      ],
      "type": "object"
    },
    "RecentNote": {
      "additionalProperties": false,
      "description": "One note `recent` lists.",
      "properties": {
        "excerpt": {
          "description": "Its start; `get` reads it whole.",
          "maxLength": 400,
          "type": "string"
        },
        "id": {
          "description": "The note.",
          "format": "uuid",
          "type": "string"
        },
        "source_url": {
          "description": "The URL it came from.",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "stored_at": {
          "description": "When it was stored.",
          "format": "date-time",
          "type": "string"
        },
        "tags": {
          "description": "Its tags.",
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "title": {
          "description": "Its title.",
          "maxLength": 256,
          "type": "string"
        },
        "truncated": {
          "description": "True if the note is longer than `excerpt`.",
          "type": "boolean"
        },
        "trust": {
          "$ref": "#/$defs/TrustLabel",
          "description": "Whether it may be treated as instructions."
        }
      },
      "required": [
        "id",
        "title",
        "excerpt",
        "truncated",
        "tags",
        "stored_at",
        "trust"
      ],
      "type": "object"
    },
    "SkippedSource": {
      "additionalProperties": false,
      "description": "A source left out of the search, and why: it failed, ran out of time,\nor couldn't be searched by this query. One that found nothing isn't\nlisted.",
      "properties": {
        "source": {
          "description": "The source, as `plugin.name`.",
          "maxLength": 65,
          "type": "string"
        },
        "why": {
          "description": "Why.",
          "maxLength": 512,
          "type": "string"
        }
      },
      "required": [
        "source",
        "why"
      ],
      "type": "object"
    },
    "SourceHit": {
      "additionalProperties": false,
      "description": "An item a plugin's source holds. Always untrusted.",
      "properties": {
        "id": {
          "description": "The item's id within it: `open` reads it whole.",
          "maxLength": 256,
          "type": "string"
        },
        "score": {
          "description": "Its score, comparable with the notes' within this search.",
          "format": "float",
          "type": "number"
        },
        "similarity": {
          "description": "How close it is in meaning to the query, if the source searched\nwith the query's vector.",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "source": {
          "description": "The source, as `plugin.name`.",
          "maxLength": 65,
          "type": "string"
        },
        "source_url": {
          "description": "The URL it came from.",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "The part that matched; `open` reads all of it.",
          "maxLength": 100000,
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "maxLength": 256,
          "type": "string"
        },
        "updated_at": {
          "description": "When it last changed, if the source knows.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source",
        "id",
        "title",
        "text",
        "score"
      ],
      "type": "object"
    },
    "TrustLabel": {
      "description": "Whether a note may be treated as instructions.",
      "enum": [
        "trusted",
        "untrusted"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "What the tool did.",
  "oneOf": [
    {
      "additionalProperties": false,
      "description": "The note was stored or changed.",
      "properties": {
        "chunks": {
          "description": "How many chunks it has.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "created": {
          "description": "False if it already existed, or was changed.",
          "type": "boolean"
        },
        "id": {
          "description": "The note.",
          "format": "uuid",
          "type": "string"
        },
        "result": {
          "const": "stored",
          "type": "string"
        },
        "unembedded_chunks": {
          "description": "How many of them only a keyword search can find.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "result",
        "id",
        "created",
        "chunks",
        "unembedded_chunks"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "What a search found.",
      "properties": {
        "has_more": {
          "description": "True when more notes matched than are listed.",
          "type": "boolean"
        },
        "hits": {
          "description": "The notes, best first.",
          "items": {
            "$ref": "#/$defs/Hit"
          },
          "maxItems": 50,
          "type": "array"
        },
        "keyword_only_because": {
          "description": "Set when vectors weren't used, with why.",
          "maxLength": 512,
          "type": [
            "string",
            "null"
          ]
        },
        "not_close_enough": {
          "default": 0,
          "description": "Notes that matched and were left out for being less similar\nthan `min_similarity`.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "result": {
          "const": "found",
          "type": "string"
        },
        "sources": {
          "description": "Items in plugins' sources, ranked with the notes: compare\n`score`.",
          "items": {
            "$ref": "#/$defs/SourceHit"
          },
          "maxItems": 50,
          "type": "array"
        },
        "sources_cut": {
          "description": "Sources some of whose hits were left out, and why: more than\nwere asked for, or an id empty, too long or given twice.",
          "items": {
            "$ref": "#/$defs/SkippedSource"
          },
          "maxItems": 50,
          "type": "array"
        },
        "sources_skipped": {
          "description": "Sources left out of the search, because they failed, ran out of\ntime or couldn't be searched by this query, and why.",
          "items": {
            "$ref": "#/$defs/SkippedSource"
          },
          "maxItems": 50,
          "type": "array"
        }
      },
      "required": [
        "result",
        "hits",
        "has_more",
        "sources",
        "sources_skipped"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "One note.",
      "properties": {
        "id": {
          "description": "The note.",
          "format": "uuid",
          "type": "string"
        },
        "result": {
          "const": "note",
          "type": "string"
        },
        "source_url": {
          "description": "The URL it came from.",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "tags": {
          "description": "Its tags.",
          "items": {
            "maxLength": 64,
            "type": "string"
          },
          "maxItems": 16,
          "type": "array"
        },
        "text": {
          "description": "Its text.",
          "maxLength": 100000,
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "maxLength": 256,
          "type": "string"
        },
        "truncated": {
          "description": "True if the note is longer than `text`.",
          "type": "boolean"
        },
        "trust": {
          "$ref": "#/$defs/TrustLabel",
          "description": "Whether it may be treated as instructions."
        }
      },
      "required": [
        "result",
        "id",
        "title",
        "text",
        "truncated",
        "tags",
        "trust"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "One item of a source, read whole with `open`. Always untrusted.",
      "properties": {
        "id": {
          "description": "The item's id within it.",
          "maxLength": 256,
          "type": "string"
        },
        "result": {
          "const": "item",
          "type": "string"
        },
        "source": {
          "description": "The source, as `plugin.name`.",
          "maxLength": 65,
          "type": "string"
        },
        "source_url": {
          "description": "The URL it came from.",
          "maxLength": 2048,
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "description": "Its text.",
          "maxLength": 100000,
          "type": "string"
        },
        "title": {
          "description": "Its title.",
          "maxLength": 256,
          "type": "string"
        },
        "truncated": {
          "description": "True if the item is longer than `text`.",
          "type": "boolean"
        },
        "updated_at": {
          "description": "When it last changed, if the source knows.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "result",
        "source",
        "id",
        "title",
        "text",
        "truncated"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The notes stored in a window, the latest first.",
      "properties": {
        "has_more": {
          "description": "True when more notes are in the window than are listed.",
          "type": "boolean"
        },
        "notes": {
          "description": "The notes, the latest stored first.",
          "items": {
            "$ref": "#/$defs/RecentNote"
          },
          "maxItems": 50,
          "type": "array"
        },
        "result": {
          "const": "recent",
          "type": "string"
        },
        "since": {
          "description": "The window's start.",
          "format": "date-time",
          "type": "string"
        },
        "total": {
          "description": "How many notes the window holds, listed or not.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "until": {
          "description": "Where it ends, not included; none is up to now.",
          "format": "date-time",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "result",
        "since",
        "total",
        "has_more",
        "notes"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "description": "The note is gone.",
      "properties": {
        "id": {
          "description": "The note.",
          "format": "uuid",
          "type": "string"
        },
        "result": {
          "const": "deleted",
          "type": "string"
        }
      },
      "required": [
        "result",
        "id"
      ],
      "type": "object"
    }
  ],
  "title": "MemoryResult"
}
