{
  "$defs": {
    "Class": {
      "description": "Who may see something.",
      "oneOf": [
        {
          "const": "private",
          "description": "Only providers that keep no logs.",
          "type": "string"
        },
        {
          "const": "public",
          "description": "Marked public.",
          "type": "string"
        }
      ]
    },
    "Origin": {
      "additionalProperties": false,
      "description": "Where something came from.",
      "properties": {
        "data_class": {
          "$ref": "#/$defs/Class",
          "description": "Who may see it."
        },
        "stored_at": {
          "description": "When.",
          "format": "date-time",
          "type": "string"
        },
        "stored_by": {
          "description": "Who stored it.",
          "maxLength": 256,
          "type": "string"
        },
        "trust": {
          "$ref": "#/$defs/TrustLevel",
          "description": "Whether it may be treated as instructions."
        }
      },
      "required": [
        "data_class",
        "trust",
        "stored_by",
        "stored_at"
      ],
      "type": "object"
    },
    "TrustLevel": {
      "description": "Whether something may be treated as instructions.",
      "oneOf": [
        {
          "const": "trusted",
          "description": "Written by the owner or the runtime.",
          "type": "string"
        },
        {
          "const": "untrusted",
          "description": "From outside, or written by a model.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A note, without its chunks, which are in `chunks.jsonl`.",
  "properties": {
    "body": {
      "description": "Its text.",
      "maxLength": 1000000,
      "type": "string"
    },
    "content_hash": {
      "description": "A hash of its content.",
      "maxLength": 256,
      "type": "string"
    },
    "id": {
      "description": "Its id.",
      "format": "uuid",
      "type": "string"
    },
    "origin": {
      "$ref": "#/$defs/Origin",
      "description": "Where it came from."
    },
    "source_url": {
      "description": "Where it came from, if it was fetched.",
      "maxLength": 8192,
      "type": [
        "string",
        "null"
      ]
    },
    "tags": {
      "description": "Its tags.",
      "items": {
        "maxLength": 1024,
        "type": "string"
      },
      "maxItems": 256,
      "type": "array"
    },
    "title": {
      "description": "Its title.",
      "maxLength": 4096,
      "type": "string"
    },
    "updated_at": {
      "description": "When it last changed.",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "id",
    "title",
    "body",
    "tags",
    "content_hash",
    "origin",
    "updated_at"
  ],
  "title": "NoteLine",
  "type": "object"
}
