{
  "$defs": {
    "PluginCapability": {
      "description": "A thing a plugin can ask for. A closed list, granted by name.",
      "oneOf": [
        {
          "const": "records",
          "description": "Its own records in the store.",
          "type": "string"
        },
        {
          "const": "http",
          "description": "HTTP through the runtime.",
          "type": "string"
        },
        {
          "const": "model",
          "description": "Model calls through the runtime.",
          "type": "string"
        },
        {
          "const": "memory",
          "description": "Notes in the runtime's long-term memory, which its search finds.",
          "type": "string"
        },
        {
          "const": "jobs",
          "description": "Workflow runs started as jobs, and the state of the ones it started.",
          "type": "string"
        }
      ]
    },
    "PluginConfig": {
      "additionalProperties": false,
      "description": "What one plugin is granted.",
      "properties": {
        "capabilities": {
          "description": "The capabilities it may use.",
          "items": {
            "$ref": "#/$defs/PluginCapability"
          },
          "maxItems": 8,
          "type": "array"
        },
        "name": {
          "description": "The plugin's name.",
          "maxLength": 32,
          "minLength": 1,
          "type": "string"
        },
        "process": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProcessConfig"
            },
            {
              "type": "null"
            }
          ],
          "description": "How to start it as its own process. Left out, it's a plugin compiled\ninto the binary."
        }
      },
      "required": [
        "name",
        "capabilities"
      ],
      "type": "object"
    },
    "ProcessConfig": {
      "additionalProperties": false,
      "description": "A plugin that runs as its own process.",
      "properties": {
        "args": {
          "default": [],
          "description": "Its arguments.",
          "items": {
            "maxLength": 1024,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "command": {
          "description": "The program to run.",
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "env": {
          "default": [],
          "description": "The environment variables it may see. Its environment is otherwise\nempty.",
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 32,
          "type": "array"
        },
        "manifest": {
          "description": "Its manifest file. Its name must be this plugin's.",
          "maxLength": 1024,
          "minLength": 1,
          "type": "string"
        },
        "timeout_secs": {
          "default": 30,
          "description": "How long one call may take, in seconds.",
          "format": "uint32",
          "maximum": 3600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "command",
        "manifest"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The contents of `plugins.yaml`.",
  "properties": {
    "plugins": {
      "description": "The plugins given anything. A plugin not listed is granted nothing.",
      "items": {
        "$ref": "#/$defs/PluginConfig"
      },
      "maxItems": 128,
      "type": "array"
    },
    "version": {
      "description": "The format version.",
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "version",
    "plugins"
  ],
  "title": "PluginsConfig",
  "type": "object"
}
