{
  "$defs": {
    "ForEach": {
      "additionalProperties": false,
      "description": "Runs a step once per item of a list, one after another, out of the\nstep's money and time. Each run sees its item as `{{item}}`.",
      "properties": {
        "continue_on_failure": {
          "default": false,
          "description": "Whether an item that fails lets the rest run. If not, the first\nfailure fails the step.",
          "type": "boolean"
        },
        "items": {
          "description": "One reference to a list, such as `{{steps.find.result.links}}`.",
          "maxLength": 256,
          "minLength": 5,
          "type": "string"
        },
        "max_items": {
          "description": "The most items it runs for. A longer list is cut, and the step's\n`fan_out` says so.",
          "format": "uint32",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "items",
        "max_items"
      ],
      "type": "object"
    },
    "Step": {
      "description": "One step of a workflow.",
      "oneOf": [
        {
          "additionalProperties": false,
          "description": "Calls a tool.",
          "properties": {
            "arguments": {
              "description": "Its arguments. Strings may hold references.",
              "x-extension": "checked against the tool's input schema"
            },
            "for_each": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ForEach"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Runs it once per item, which the arguments see as `{{item}}`."
            },
            "id": {
              "description": "Its name, which later steps refer to.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "tool": {
              "description": "The tool.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "tool",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "tool",
            "arguments"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "description": "Asks a sub-agent.",
          "properties": {
            "agent": {
              "description": "The agent.",
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            "context": {
              "description": "What it should work from, usually an earlier step's output.",
              "maxLength": 4096,
              "type": [
                "string",
                "null"
              ]
            },
            "for_each": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ForEach"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Asks it once per item, which only `context` may use, as `{{item}}`."
            },
            "id": {
              "description": "Its name, which later steps refer to.",
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[a-z][a-z0-9_]*$",
              "type": "string"
            },
            "message": {
              "description": "What to ask. It may refer to `inputs`, but not to steps: what\nearlier steps found goes in `context`, labelled as data.",
              "maxLength": 16000,
              "minLength": 1,
              "type": "string"
            },
            "type": {
              "const": "agent",
              "type": "string"
            }
          },
          "required": [
            "type",
            "id",
            "agent",
            "message"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A fixed list of steps.",
  "properties": {
    "description": {
      "default": "",
      "description": "What it's for.",
      "maxLength": 1024,
      "type": "string"
    },
    "inputs": {
      "description": "The JSON Schema of its inputs, which must be strict.",
      "x-extension": "the workflow's own schema, checked for strictness"
    },
    "max_usd_micros": {
      "default": 0,
      "description": "The most the whole run may spend, in millionths of a dollar.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "output": {
      "description": "What it returns: a reference, or text with references in it.",
      "maxLength": 4096,
      "type": [
        "string",
        "null"
      ]
    },
    "steps": {
      "description": "The steps, in order.",
      "items": {
        "$ref": "#/$defs/Step"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    }
  },
  "required": [
    "inputs",
    "steps"
  ],
  "title": "Workflow",
  "type": "object"
}
