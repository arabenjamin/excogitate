{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "inputs": false,
          "task": {
            "pattern": "\\S"
          }
        },
        "required": [
          "task"
        ]
      },
      "if": {
        "properties": {
          "target": {
            "const": "workflow"
          }
        },
        "required": [
          "target"
        ]
      },
      "then": {
        "properties": {
          "inputs": {
            "type": "object"
          },
          "routed": {
            "const": false
          },
          "task": {
            "maxLength": 0
          }
        },
        "required": [
          "inputs"
        ]
      }
    }
  ],
  "description": "What to improve.",
  "properties": {
    "agent": {
      "description": "The agent, or the workflow when `target` is `workflow`.",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9_-]{1,64}$",
      "type": "string"
    },
    "inputs": {
      "additionalProperties": true,
      "description": "For a workflow: the inputs to run it on, checked against its inputs\nschema.",
      "type": [
        "object",
        "null"
      ],
      "x-extension": "checked against the workflow's inputs schema"
    },
    "routed": {
      "description": "True to probe the agent as the routed chat runs it, as a profile or\nthe writer, rather than as a conversation.",
      "type": "boolean"
    },
    "target": {
      "description": "What to improve: an agent unless it says otherwise.",
      "oneOf": [
        {
          "const": "agent",
          "description": "An agent.",
          "type": "string"
        },
        {
          "const": "workflow",
          "description": "A workflow.",
          "type": "string"
        }
      ]
    },
    "task": {
      "description": "For an agent: a task to run it on, such as one a real run got wrong.",
      "maxLength": 8000,
      "type": "string"
    },
    "why": {
      "description": "What went wrong, if someone said.",
      "maxLength": 2000,
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "agent"
  ],
  "title": "Request",
  "type": "object"
}
