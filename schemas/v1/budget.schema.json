{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "What one run may use. Every field is required: a run doesn't get an\nunlimited anything by leaving it out. Calls are capped at 512 so a receipt\nis always bounded.",
  "properties": {
    "max_duration_ms": {
      "description": "Wall-clock time.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "max_request_bytes": {
      "description": "The size of one request to a model.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "max_rounds": {
      "description": "Model calls.",
      "format": "uint32",
      "maximum": 512,
      "minimum": 1,
      "type": "integer"
    },
    "max_tool_calls": {
      "description": "Tool calls, including the ones refused.",
      "format": "uint32",
      "maximum": 512,
      "minimum": 0,
      "type": "integer"
    },
    "max_total_tokens": {
      "description": "Tokens read and written across all model calls.",
      "format": "uint64",
      "minimum": 1,
      "type": "integer"
    },
    "max_usd_micros": {
      "description": "Money, in millionths of a dollar.",
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
    },
    "max_writes": {
      "description": "Tool calls that write.",
      "format": "uint32",
      "maximum": 512,
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "max_rounds",
    "max_tool_calls",
    "max_writes",
    "max_total_tokens",
    "max_usd_micros",
    "max_request_bytes",
    "max_duration_ms"
  ],
  "title": "Budget",
  "type": "object"
}
