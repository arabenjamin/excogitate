{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An HTTP response on the wire.",
  "properties": {
    "body": {
      "maxLength": 1000000,
      "type": "string"
    },
    "note": {
      "maxLength": 1024,
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": "integer"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "status",
    "body",
    "truncated"
  ],
  "title": "WireHttpResponse",
  "type": "object"
}
