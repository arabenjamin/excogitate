{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "An agent the system leaves alone until the owner releases it.",
  "properties": {
    "agent": {
      "description": "The agent, or the workflow.",
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "reason": {
      "description": "Why.",
      "maxLength": 2048,
      "type": "string"
    },
    "since": {
      "description": "Since when.",
      "format": "date-time",
      "type": "string"
    },
    "target": {
      "description": "What it is: an agent unless it says otherwise.",
      "oneOf": [
        {
          "const": "agent",
          "description": "An agent.",
          "type": "string"
        },
        {
          "const": "workflow",
          "description": "A workflow.",
          "type": "string"
        }
      ]
    }
  },
  "required": [
    "agent",
    "since",
    "reason"
  ],
  "title": "Hold",
  "type": "object"
}
